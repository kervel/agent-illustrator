// Railway topology at three levels of abstraction.
//   Micro: the real track: two main tracks (A on top, B below) joined by two crossovers.
//   Meso:  the same track, greyed, with the two operational points (OPs) drawn over it.
//   Macro: each OP becomes a node; the track between them becomes one section of line.
// Micro and Meso each declare their 8 track dots; the `rails` template wires
// the dots of one level into the track shape, so that shape is written once.

// The track shape between 8 dots (l = left end, x = crossover junction, r = right end):
//   A: al -- ax1 ------------ ax2 -- ar
//              \                  /
//   B: bl ------ bx1 -- bx2 ------ br
// The B junctions are 140px apart, centred between the ends; each A junction sits
// 40px further out, so the crossovers run diagonally.
template "rails" (al: "", ax1: "", ax2: "", ar: "", bl: "", bx1: "", bx2: "", br: "", ink: text-1) {
    constrain al.center_x = bl.center_x
    constrain ar.center_x = br.center_x
    constrain bx2.center_x = bx1.center_x + 140
    constrain bx1.center_x = midpoint(bl, br) - 70
    constrain ax1.center_x = bx1.center_x - 40
    constrain ax2.center_x = bx2.center_x + 40

    each s in [
        {p: al,  q: ax1}, {p: ax1, q: ax2}, {p: ax2, q: ar},   // track A
        {p: bl,  q: bx1}, {p: bx1, q: bx2}, {p: bx2, q: br},   // track B
        {p: ax1, q: bx1}, {p: bx2, q: ax2},                    // crossovers
    ] {
        s.p -- s.q [stroke: ink, stroke_width: 2, routing: direct]
    }
}

col diagram {
    // === MICRO ===
    group micro {
        col micro_label [role: label] {
            text "Micro" micro_lbl [font_size: 20, fill: text-1]
            text "Detailed tracks" [font_size: 12, fill: text-2]
        }
        col tracks [gap: 30] {
            row trackA [gap: 80] {
                circle a1 [fill: accent-1, size: 6]
                circle jA1 [fill: accent-1, size: 6]
                circle jA2 [fill: accent-1, size: 6]
                circle a2 [fill: accent-1, size: 6]
            }
            row trackB [gap: 80] {
                circle b1 [fill: accent-1, size: 6]
                circle jB1 [fill: accent-1, size: 6]
                circle jB2 [fill: accent-1, size: 6]
                circle b2 [fill: accent-1, size: 6]
            }
        }
        rails micro_rails [al: a1, ax1: jA1, ax2: jA2, ar: a2, bl: b1, bx1: jB1, bx2: jB2, br: b2]
    }

    // === MESO === the same track, greyed, under the operational points
    group meso {
        col meso_label [role: label] {
            text "Meso" meso_lbl [font_size: 20, fill: text-1]
            text "OPs + Tracks" [font_size: 12, fill: text-2]
        }
        stack meso_content {
            // An OP is a dashed ellipse over the crossover it contains
            ellipse op1 [fill: accent-light, opacity: 0.3, stroke: accent-1, stroke_dasharray: "6,3", width: 140, height: 80, label: "OP 1 (Station)"]
            ellipse op2 [fill: accent-light, opacity: 0.3, stroke: accent-1, stroke_dasharray: "6,3", width: 140, height: 80, label: "OP 2 (Station)"]
            col meso_tracks [gap: 30] {
                row mtrackA [gap: 80] {
                    circle ma1 [fill: foreground-3, size: 6]
                    circle mjA1 [fill: foreground-3, size: 6]
                    circle mjA2 [fill: foreground-3, size: 6]
                    circle ma2 [fill: foreground-3, size: 6]
                }
                row mtrackB [gap: 80] {
                    circle mb1 [fill: foreground-3, size: 6]
                    circle mjB1 [fill: foreground-3, size: 6]
                    circle mjB2 [fill: foreground-3, size: 6]
                    circle mb2 [fill: foreground-3, size: 6]
                }
            }
        }
        rails meso_rails [al: ma1, ax1: mjA1, ax2: mjA2, ar: ma2, bl: mb1, bx1: mjB1, bx2: mjB2, br: mb2, ink: foreground-3]
        constrain op1.center = midpoint(mjA1, mjB1)
        constrain op2.center = midpoint(mjA2, mjB2)
    }

    // === MACRO === one node per OP, one line between them
    group macro {
        col macro_label [role: label] {
            text "Macro" macro_lbl [font_size: 20, fill: text-1]
            text "Nodes & Lines" [font_size: 12, fill: text-2]
        }
        row graph [gap: 100] {
            circle n1 [fill: accent-1, size: 50, label: "OP 1"]
            circle n2 [fill: accent-1, size: 50, label: "OP 2"]
            n1 -- n2 [stroke: accent-1, stroke_width: 3, label: "Section of Line (SoL)", routing: direct]
        }
    }

    // The three views share their ends (the track shape does the rest)
    constrain mb1.center_x = b1.center_x
    constrain mb2.center_x = b2.center_x
    constrain n1.left = b1.left
    constrain n2.right = b2.right

    // Arrows down the label column: micro -> meso -> macro
    text "Aggregation" agg_label [font_size: 11, fill: foreground-3]
    text "Simplification" simp_label [font_size: 11, fill: foreground-3]
    micro_label.bottom -> meso_label.top [label: agg_label, label_position: right, stroke: foreground-3, routing: direct]
    meso_label.bottom -> macro_label.top [label: simp_label, label_position: right, stroke: foreground-3, routing: direct]

    // One vertical axis for the level labels (containers, for the arrows) and their titles
    constrain micro_label.center_x = meso_label.center_x
    constrain meso_label.center_x = macro_label.center_x
    constrain micro_lbl.center_x = meso_lbl.center_x
    constrain meso_lbl.center_x = macro_lbl.center_x
}
