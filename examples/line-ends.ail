/* INTENT
   A reference chart of every line-end style, UML-flavoured.
   Audience: authors choosing how a relation should look.
   They should see: each end style (arrow, open, triangle, diamond,
   diamond-filled, crow, circle, none) at work, the exact modifiers that draw
   it, that `from_end`/`to_end` work on either end, and that ends combine with
   dashed lines.

   The chart is one table of records and one `each`: every record is a row
   (two boxes, the line between them, the code that draws it). A record field
   holds an end value (`te: "triangle"`) or a dash style (`dash: none`); the
   end values are quoted because the code column also shows them as text.
   To add a row, add a record.
*/

text "Line ends: [from_end: ..., to_end: ...]" title [font_size: 16]

col chart [gap: 22, align: start] {
    each r in [
        {a: "Dog",      b: "Animal",     fe: "none",           te: "triangle",  dash: none,   means: "inheritance"},
        {a: "Impl",     b: "Interface",  fe: "none",           te: "triangle",  dash: dashed, means: "realisation (dashed)"},
        {a: "Garage",   b: "Car",        fe: "diamond",        te: "none",      dash: none,   means: "aggregation"},
        {a: "House",    b: "Room",       fe: "diamond-filled", te: "none",      dash: none,   means: "composition"},
        {a: "Client",   b: "Service",    fe: "none",           te: "open",      dash: dashed, means: "dependency (dashed)"},
        {a: "Customer", b: "Order",      fe: "none",           te: "crow",      dash: none,   means: "one to many"},
        {a: "Plug",     b: "Socket",     fe: "circle",         te: "circle",    dash: none,   means: "socket"},
        {a: "Source",   b: "Sink",       fe: "arrow",          te: "arrow",     dash: none,   means: "both ways"},
    ] {
        row entry [gap: 36, align: center] {
            row pair [gap: 170] {
                rect a [width: 110, height: 34, label: r.a]
                rect b [width: 110, height: 34, label: r.b]
            }
            text "from_end: {r.fe}, to_end: {r.te}" code [font_family: mono, font_size: 12]
        }
        a -- b [from_end: r.fe, to_end: r.te, stroke_dasharray: r.dash, label: r.means]
    }
}
constrain title.left = chart.left
constrain title.bottom = chart.top - 18
