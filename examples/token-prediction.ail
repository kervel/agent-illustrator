/* STORYBOARD (constraint-toggle motion, three predict→append cycles)
   prompt:      box [The cat sat] + LLM; feed arrow box->LLM.
   predict_on:  "on" appears below the LLM (red) + predict arrow.
   append_on:   box grows a slot; "on" slides up into it, turns plain.
   predict_the: "the" appears below the LLM (red) + predict arrow.
   append_the:  box grows; "the" slides up, turns plain.
   predict_mat: "mat" appears below the LLM (red) + predict arrow.
   append_mat:  box grows; "mat" slides up, turns plain → [The cat sat on the mat].
   STORY ARC: the model predicts ONE token, appends it to its own input, and runs
   again — three times, so the loop is unmistakable. Each predicted token (red)
   becomes plain input as it's appended.

   The input box grows via `transform inbox [width: N]` and the feed arrow follows
   the growing right edge automatically (AIL re-anchors connections to their
   endpoints every keyframe — no extra constraints needed).
*/

rect canvas [width: 800, height: 420, fill: white, stroke: none, opacity: 0.01]
constrain canvas.center_x = 380
constrain canvas.center_y = 200

rect inbox [width: 190, height: 70, fill: #eef3f6, stroke: secondary-1, stroke_width: 2]
constrain inbox.left = 80
constrain inbox.center_y = 150

/* input chips at fixed slots (pitch 56); the box grows past them to the right */
rect a [width: 50, height: 38, fill: #ffffff, stroke: #cdd8e3, label: "The"]
rect b [width: 50, height: 38, fill: #ffffff, stroke: #cdd8e3, label: "cat"]
rect c [width: 50, height: 38, fill: #ffffff, stroke: #cdd8e3, label: "sat"]
constrain a.center_y = 150
constrain b.center_y = 150
constrain c.center_y = 150
constrain a.center_x = 119
constrain b.center_x = 175
constrain c.center_x = 231

rect llm [width: 150, height: 64, fill: secondary-1, label: "LLM"]
constrain llm.center_x = 560
constrain llm.center_y = 150

/* predicted tokens — each starts below the LLM (red = just predicted) */
rect d [width: 50, height: 38, fill: #ffffff, stroke: accent-1, stroke_width: 3, label: "on"]
rect e [width: 50, height: 38, fill: #ffffff, stroke: accent-1, stroke_width: 3, label: "the"]
rect f [width: 50, height: 38, fill: #ffffff, stroke: accent-1, stroke_width: 3, label: "mat"]
constrain d.center_x = llm.center_x as d_hx
constrain d.center_y = 300 as d_hy
constrain e.center_x = llm.center_x as e_hx
constrain e.center_y = 300 as e_hy
constrain f.center_x = llm.center_x as f_hx
constrain f.center_y = 300 as f_hy

inbox.right -> llm.left as feed [stroke: foreground-2, stroke_width: 2]
llm.bottom -> d.top as parrow_d [stroke: accent-1, stroke_width: 2, label: "predicts one token"]
llm.bottom -> e.top as parrow_e [stroke: accent-1, stroke_width: 2]
llm.bottom -> f.top as parrow_f [stroke: accent-1, stroke_width: 2]

text "Predict one token, append it — then repeat." cap [fill: #1b2733]
constrain cap.center_x = 360
constrain cap.top = 360

keyframe "prompt" {
    hide d, e, f, parrow_d, parrow_e, parrow_f
}
keyframe "predict_on" {
    show d, parrow_d
}
keyframe "append_on" {
    hide parrow_d
    transform inbox [width: 246]
    disable d_hx
    disable d_hy
    constrain d.center_x = 287
    constrain d.center_y = 150
    transform d [stroke: #cdd8e3, stroke_width: 1]
}
keyframe "predict_the" {
    show e, parrow_e
}
keyframe "append_the" {
    hide parrow_e
    transform inbox [width: 302]
    disable e_hx
    disable e_hy
    constrain e.center_x = 343
    constrain e.center_y = 150
    transform e [stroke: #cdd8e3, stroke_width: 1]
}
keyframe "predict_mat" {
    show f, parrow_f
}
keyframe "append_mat" {
    hide parrow_f
    transform inbox [width: 358]
    disable f_hx
    disable f_hy
    constrain f.center_x = 399
    constrain f.center_y = 150
    transform f [stroke: #cdd8e3, stroke_width: 1]
}
