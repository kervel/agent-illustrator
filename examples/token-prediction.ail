/* STORYBOARD (constraint-toggle motion, three predict→append cycles)
   prompt:      box [The cat sat] + LLM; feed arrow box->LLM.
   predict_on:  "on" appears below the LLM (red) + predict arrow.
   append_on:   box grows a slot; "on" slides up into it, turns plain.
   predict_the: "the" appears below the LLM (red) + predict arrow.
   append_the:  box grows; "the" slides up, turns plain.
   predict_mat: "mat" appears below the LLM (red) + predict arrow.
   append_mat:  box grows; "mat" slides up, turns plain → [The cat sat on the mat].
   STORY ARC: the model predicts ONE token, appends it to its own input, and runs
   again — three times, so the loop is unmistakable. Each predicted token (red)
   becomes plain input as it's appended.

   The token lists are data: one `each` makes the prompt chips (tok_1..tok_3),
   another the predicted chips (next_1..next_3), each with its own arrow
   (predict_1..3) and its own home pins (home_x_1, home_y_1, ...). Appending a
   token = disable its home pins and pin it after the previous chip; the box
   grows by one chip pitch (56) and the feed arrow follows its right edge.
*/

rect canvas [width: 800, height: 420, fill: white, stroke: none, opacity: 0.01]
constrain canvas.center_x = 380
constrain canvas.center_y = 200

rect inbox [width: 190, height: 70, fill: #eef3f6, stroke: secondary-1, stroke_width: 2]
constrain inbox.left = 80
constrain inbox.center_y = 150

row prompt [gap: 6, overlaps: inbox] {
    each w in ["The", "cat", "sat"] {
        rect tok [width: 50, height: 38, fill: #ffffff, stroke: #cdd8e3, label: w]
    }
}
constrain tok_1.left = inbox.left + 14
constrain prompt.center_y = inbox.center_y

rect llm [width: 150, height: 64, fill: secondary-1, label: "LLM"]
constrain llm.center_x = 560
constrain llm.center_y = inbox.center_y
inbox.right -> llm.left as feed [stroke: foreground-2, stroke_width: 2]

// Predicted tokens wait below the LLM (red = just predicted). Each keeps its
// own named home pins, so a keyframe can release one chip without the others.
each w in ["on", "the", "mat"] {
    rect next [width: 50, height: 38, fill: #ffffff, stroke: accent-1, stroke_width: 3, label: w]
    constrain next.center_x = llm.center_x as home_x
    constrain next.top = llm.bottom + 99 as home_y
    llm.bottom -> next.top as predict [stroke: accent-1, stroke_width: 2, label: "predicts one token"]
}

text "Predict one token, append it — then repeat." cap [fill: #1b2733]
constrain cap.center_x = 360
constrain cap.top = 360

keyframe "prompt" {
    hide next_1, next_2, next_3, predict_1, predict_2, predict_3
}
keyframe "predict_on" {
    show next_1, predict_1
}
keyframe "append_on" {
    hide predict_1
    transform inbox [width: 246]
    disable home_x_1
    disable home_y_1
    constrain next_1.left = tok_3.right + 6
    constrain next_1.center_y = inbox.center_y
    transform next_1 [stroke: #cdd8e3, stroke_width: 1]
}
keyframe "predict_the" {
    show next_2, predict_2
}
keyframe "append_the" {
    hide predict_2
    transform inbox [width: 302]
    disable home_x_2
    disable home_y_2
    constrain next_2.left = next_1.right + 6
    constrain next_2.center_y = inbox.center_y
    transform next_2 [stroke: #cdd8e3, stroke_width: 1]
}
keyframe "predict_mat" {
    show next_3, predict_3
}
keyframe "append_mat" {
    hide predict_3
    transform inbox [width: 358]
    disable home_x_3
    disable home_y_3
    constrain next_3.left = next_2.right + 6
    constrain next_3.center_y = inbox.center_y
    transform next_3 [stroke: #cdd8e3, stroke_width: 1]
}
