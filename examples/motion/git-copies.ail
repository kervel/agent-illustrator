/* Scene 1 of the git deck: "Sound familiar?"
   Render: agent-illustrator --stylesheet-css git-deck.css --animate git-copies.ail

   STORYBOARD
     one_file  badge and title arrive; one report pops up in the middle
     copies    seven copies fly out of it into a grid; "?" badges pop in random
               order and the files wiggle
     code      the badges go; every file flips into a code file; the caption rises
*/

import "git-deck.ail"

// ---------------------------------------------------------------- parts

// A page: a sheet with a folded corner and six lines of text.
template "page" (b1: git-rule, b2: git-rule, b3: git-rule, b4: git-rule, b5: git-rule, b6: git-rule) {
    rect sheet [width: 120, height: 156, fill: git-panel, stroke: git-ink, stroke_width: 3, corner_radius: 8]
    path fold [fill: git-rule, stroke: git-ink, stroke_width: 3] {
        vertex a [x: 0, y: 0]
        line_to b [x: 28, y: 28]
        line_to c [x: 0, y: 28]
        close
    }
    col lines [gap: 12] {
        rect l* [width: [88, 70, 55, 70, 88, 55], height: 9, fill: [b1, b2, b3, b4, b5, b6],
                 stroke: none, corner_radius: 4]
    }
    constrain fold.right = sheet.right
    constrain fold.top = sheet.top
    constrain lines.left = sheet.left + 16
    constrain lines.top = sheet.top + 34
}

// A document: a page, its file name, and a "?" that pops in later.
template "doc" (fname: "report.docx") {
    page pg
    rect name [fill: none, stroke: none, label: fname, font_size: 17, font_family: mono,
               label_fill: git-ink, max_width: 250]
    circle q [size: 46, fill: git-warn, stroke: git-ink, stroke_width: 3, label: "?", font_size: 28,
              font_weight: 800, label_fill: git-ink, class: q, appears: later]
    constrain name.center_x = pg.center_x
    constrain name.top = pg.bottom + 12
    constrain q.left = pg.sheet.left - 8
    constrain q.center_y = pg.sheet.top + 4
}

// A code file: the same page, its lines coloured and indented like code.
template "code" (fname: "main.py", c1: git-main, c2: git-ok, c3: git-branch) {
    page pg [b1: c1, b3: c2, b5: c3]
    rect name [fill: none, stroke: none, label: fname, font_size: 17, font_family: mono,
               label_fill: git-ink, max_width: 250]
    constrain name.center_x = pg.center_x
    constrain name.top = pg.bottom + 12
}

// ---------------------------------------------------------------- stage

slide s [num: "1", title: "Sound familiar?"]

grid docs [cols: 4, gap: 60, cell_width: 280, cell_height: 220] {
    doc d* [fname: ["report.docx", "report_v2.docx", "report_v2_anna.docx", "report_final.docx",
                    "report_final2.docx", "report_final_REALLY.docx", "Copy of report_final_REALLY.docx",
                    "report_OLD_dont_use.docx"]]
}
constrain docs.center_x = s.stage.center_x
constrain docs.top = s.stage.top + 200

grid codes [cols: 4, gap: 60, cell_width: 280, cell_height: 220] {
    code k* [fname: ["login.py", "cart.py", "checkout.js", "style.css",
                     "orders_api.py", "README.md", "test_cart.py", "Dockerfile"],
             c1: [git-main, git-ok, git-branch, git-main, git-ok, git-branch, git-main, git-ok],
             c3: [git-branch, git-main, git-ok, git-branch, git-main, git-ok, git-branch, git-main]]
}
constrain codes.left = docs.left
constrain codes.top = docs.top

// Where the first report appears: the middle of the grid.
rect hub [width: 1, height: 1, fill: none, stroke: none]
constrain hub.center = docs.center

rect caption [fill: none, stroke: none, font_size: 40, font_weight: 800, label_fill: git-ink, appears: code,
              label: "4,000 files <span fill=git-branch>×</span> 30 developers <span fill=git-branch>×</span> every day"]
constrain caption.center_x = s.stage.center_x
constrain caption.top = docs.bottom + 40

// ---------------------------------------------------------------- motion

keyframe "one_file" {
    hide docs.*, codes.*
    move d0 to hub
    slide_in(s)
    after 0.2 { show d0 [enter: pop] }
}

keyframe "copies" {
    show docs.* [from: d0, stagger: 0.1, duration: slow, jitter: 4]
    move d0 home [duration: slow, ease: glide]
    after 1.2 { show .q [enter: pop, stagger: 0.05, order: random] }
    after 0.15 { shake docs.* [stagger: 0.04, order: random] }
}

keyframe "code" {
    hide .q [exit: shrink, duration: 0.2]
    after 0.15 { swap docs.* -> codes.* [via: flip, flip: pg, stagger: 0.07] }
    after 0.75 { show caption [enter: rise] }
}
