/* Scene 1 of the git deck: "Sound familiar?"
   Render: agent-illustrator --stylesheet-css git-deck.css --animate git-copies.ail

   STORYBOARD
     one_file  badge and title arrive; one report pops up in the middle
     copies    seven copies fly out of it into a grid; "?" badges pop in random
               order and the files wiggle
     code      the badges go; every file flips into a code file; the caption rises
*/

import "git-deck.ail"

// ---------------------------------------------------------------- parts

// The pages are artwork (assets/*.svg): a sheet with a folded corner and six
// bars. Each id in the file is a part (pg.sheet, pg.fold, pg.bar3); the
// CSS variables b1..b6 in the file colour the bars per instance.
template "docx" from "assets/docx.svg"
template "codefile" from "assets/code.svg"

// A document: a page, its file name, and a "?" that pops in later.
template "doc" (fname: "report.docx") {
    docx pg
    rect name [fill: none, stroke: none, label: fname, font_size: 17, font_family: mono,
               label_fill: role-ink, max_width: 250]
    circle q [size: 46, fill: role-warn, stroke: role-ink, stroke_width: 3, label: "?", font_size: 28,
              font_weight: 800, label_fill: role-ink, class: q, appears: later]
    constrain name.center_x = pg.center_x
    constrain name.top = pg.bottom + 12
    constrain q.left = pg.sheet.left - 8
    constrain q.center_y = pg.sheet.top + 4
}

// A code file: the same page, its lines coloured and indented like code.
template "code" (fname: "main.py", c1: role-primary, c2: role-ok, c3: role-secondary) {
    codefile pg [b1: c1, b3: c2, b5: c3]
    rect name [fill: none, stroke: none, label: fname, font_size: 17, font_family: mono,
               label_fill: role-ink, max_width: 250]
    constrain name.center_x = pg.center_x
    constrain name.top = pg.bottom + 12
}

// ---------------------------------------------------------------- stage

slide s [num: "1", title: "Sound familiar?"]

grid docs [cols: 4, gap: 60, cell_width: 280, cell_height: 220] {
    doc d* [fname: ["report.docx", "report_v2.docx", "report_v2_anna.docx", "report_final.docx",
                    "report_final2.docx", "report_final_REALLY.docx", "Copy of report_final_REALLY.docx",
                    "report_OLD_dont_use.docx"]]
}
constrain docs.center_x = s.stage.center_x
constrain docs.top = s.stage.top + 200

group codes {
    code k* [items: [{fname: "login.py",     c1: role-primary,   c3: role-secondary},
                     {fname: "cart.py",      c1: role-ok,        c3: role-primary},
                     {fname: "checkout.js",  c1: role-secondary, c3: role-ok},
                     {fname: "style.css",    c1: role-primary,   c3: role-secondary},
                     {fname: "orders_api.py", c1: role-ok,       c3: role-primary},
                     {fname: "README.md",    c1: role-secondary, c3: role-ok},
                     {fname: "test_cart.py", c1: role-primary,   c3: role-secondary},
                     {fname: "Dockerfile",   c1: role-ok,        c3: role-primary}]]
}
// Each code file sits exactly on its report, so the flip turns in place.
constrain k*.pg.center = d*.pg.center

// Where the first report appears: the middle of the grid.
point hub
constrain hub.center = docs.center

rect caption [fill: none, stroke: none, font_size: 40, font_weight: 800, label_fill: role-ink, appears: later,
              label: "4,000 files <span fill=role-secondary>×</span> 30 developers <span fill=role-secondary>×</span> every day"]
constrain caption.center_x = s.stage.center_x
constrain caption.top = docs.bottom + 40

// ---------------------------------------------------------------- motion

keyframe "one_file" {
    hide docs.*, codes.*
    move d0 to hub
    slide_in(s)
    after 0.2 { show d0 [enter: pop] }
}

keyframe "copies" {
    show docs.* [from: d0, stagger: 0.1, duration: slow, jitter: 4]
    move d0 home [duration: slow, ease: glide]
    at 1.2 {
        show .q [enter: pop, stagger: 0.05, order: random]
        after 0.15 { shake docs.* [stagger: 0.04, order: random] }
    }
}

keyframe "code" {
    hide .q [exit: shrink, duration: 0.2]
    at 0.15 { swap docs.* -> codes.* [via: flip, flip: pg, stagger: 0.07] }
    at 0.9 { show caption [enter: rise] }
}
