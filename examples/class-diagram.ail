// UML class box: a template whose compartments are lists; `each` writes one row per item.
// Tight rows: `rh` (default 20) + font_size 12 + ONE SHORT attribute per row, "name: Type".
// Explanations belong in the text around the picture, not in a row.
// stereo: lines above the title (["«enum»"]). attrs/ops: plain rows. An empty `ops` leaves no band.
// Status lists, stacked under `attrs` and tinted: changed (amber), added (green), later (grey, muted).
// `each` iterates plain strings, so rows are grouped by status. hfill tints the title bar.
// Anchors: t_box/b_box = box top/bottom; l_hd/r_hd = title bar; l_at/r_at = attribute compartment;
// l_a/r_a (row of `attrs`, numbered l_a_1..), l_o/r_o (rows of `ops`).
// Layout lessons: a connection between title bars (r_hd -- l_hd) is straight only if the box tops
// are aligned; a vertical one (b_box -- t_box) needs the center_x aligned; a line must not cross a
// box in between (reorder the grid). `bundle: together` on inheritance lines into one parent (same
// anchor) makes them share a trunk;
// `bundle: apart` on the other lines makes lint flag any shared leg. Multiplicities = from_label/to_label, short role = label.
template "cls" (ttl: "", stereo: [], attrs: [], changed: [], added: [], later: [], ops: [],
                w: 220, rh: 20, hfill: secondary-light, edge: foreground-2, radius: 8) {
    col box [gap: 0, padding: 0] {
        col head [gap: 0, padding: 0] {
            each s in stereo {
                rect st_row [width: w, height: 16, label: s, font_size: 11, fill: hfill, stroke: none, clip: shell, label_fill: role-muted]
            }
            rect hd [width: w, height: 28, label: ttl, font_weight: bold, fill: hfill, stroke: none, clip: shell]
        }
        col at [gap: 0, padding: 0] {
            each a in attrs {
                rect a_row [width: w, height: rh, label: a, align: start, font_size: 12, fill: background-1, stroke: none, clip: shell]
                anchor l_a [position: a_row.left, direction: left]
                anchor r_a [position: a_row.right, direction: right]
            }
            each a in changed {
                rect c_row [width: w, height: rh, label: a, align: start, font_size: 12, fill: role-warn-soft, stroke: none, clip: shell]
            }
            each a in added {
                rect n_row [width: w, height: rh, label: a, align: start, font_size: 12, fill: role-ok-soft, stroke: none, clip: shell]
            }
            each a in later {
                rect l_row [width: w, height: rh, label: a, align: start, font_size: 12, fill: role-surface-2, stroke: none, clip: shell, label_fill: role-muted]
            }
        }
        col op [gap: 0, padding: 0] {
            each o in ops {
                rect o_row [width: w, height: rh, label: o, align: start, font_size: 12, fill: background-1, stroke: none, clip: shell]
                anchor l_o [position: o_row.left, direction: left]
                anchor r_o [position: o_row.right, direction: right]
            }
        }
    }
    rect hd_box [fill: none, stroke: edge, corner_radius: 0, clip: shell]
    constrain hd_box contains head
    rect at_box [fill: none, stroke: edge, corner_radius: 0, clip: shell]
    rect op_box [fill: none, stroke: edge, corner_radius: 0, clip: shell]
    rect shell [fill: none, stroke: edge, corner_radius: radius]
    constrain at_box contains at
    constrain op_box contains op
    constrain shell contains box
    anchor t_box [position: shell.top, direction: up]
    anchor b_box [position: shell.bottom, direction: down]
    anchor l_hd [position: hd.left, direction: left]
    anchor r_hd [position: hd.right, direction: right]
    anchor l_at [position: at_box.left, direction: left]
    anchor r_at [position: at_box.right, direction: right]
    anchor l_op [position: op_box.left, direction: left]
    anchor r_op [position: op_box.right, direction: right]
}

// legend: new / changed / unchanged
row legend [gap: 10] {
    rect lg_new [width: 22, height: 14, fill: role-ok-soft, stroke: foreground-2]
    text "new" lg_new_t [font_size: 12]
    rect lg_chg [width: 22, height: 14, fill: role-warn-soft, stroke: foreground-2]
    text "changed" lg_chg_t [font_size: 12]
    rect lg_old [width: 22, height: 14, fill: background-1, stroke: foreground-2]
    text "unchanged" lg_old_t [font_size: 12]
}

row cols [gap: 130]  {
    col c_l { cls approval [ttl: "EntryApproval", attrs: ["kind: ApprovalKind"]] }
    col c_m [gap: 80] {
        cls lock [ttl: "PeriodLock", attrs: ["year: int", "month: int"]]
        cls entry [ttl: "TimeEntry", hfill: role-ok-soft,
                   attrs: ["date: date", "hours: decimal"], changed: ["status: EntryStatus"],
                   added: ["billed_at: datetime?"], ops: ["+ approve()"]]
        row subs [gap: 40] {
            cls corr [ttl: "Correction", attrs: ["original: TimeEntry"]]
            cls over [ttl: "Overtime", attrs: ["rate: decimal"]]
        }
    }
    col c_r {
        cls invoice [ttl: "Invoice", attrs: ["number: str", "total: decimal", "paid: bool"], ops: ["+ pay()"]]
        cls kind [ttl: "ApprovalKind", stereo: ["«enum»"], attrs: ["manager", "client"]]
    }
}
constrain approval.top = entry.top
constrain invoice.top = entry.top
constrain corr.center_x = entry.center_x
constrain kind.center_x = approval.center_x
constrain kind.top = approval.bottom + 60
constrain legend.left = cols.left
constrain legend.bottom = cols.top - 30

corr.t_box -> entry.b_box [to_end: triangle, bundle: together]
over.t_box -> entry.b_box [to_end: triangle, bundle: together]
lock.b_box -> entry.t_box [to_end: open, stroke_dasharray: dashed, label: "gates", bundle: apart]
entry.r_a_2 -- invoice.l_a_2 [from_label: "*", to_label: "0..1", label: "billed on", bundle: apart]
entry.l_hd -- approval.r_hd [from_end: diamond-filled, from_label: "1", to_label: "*", bundle: apart]
approval.b_box -> kind.t_box [to_end: open, stroke_dasharray: dashed, label: "uses", bundle: apart]
