/* A state machine drawn from its transition table, and one instance of it running.

   The transitions are one named list, `let tr = [...]`, and several blocks read it:
   - `each t in tr where t.from != t.to` draws an arrow per transition between two states:
     `t.from -> t.to`, labelled with `t.on`;
   - `each t in tr where t.from == t.to` draws the self-transitions (seek keeps Playing) as a
     curved loop over the state, through two points above it;
   - `each t in tr` writes the legend of events.
   A record's field names are free (`from`, `label`, `text` work too); every record needs every
   field the body uses. A dotted value names a side or a part: `failed.left`.
   To add a transition, add a record: no line of drawing code changes. `where` keeps positions:
   the arrows are arc_1 .. arc_7 in list order, whichever block drew them.

   STORYBOARD (one click per event; the CSS version loops by itself)
     start    a token appears on the start dot and rides into Idle
     play     the token rides the "play" arrow; Playing lights up
     pause    on to Paused, where the token waits (it breathes)
     resume   back to Playing
     seek     round the loop over Playing and back into it (a self-transition)
     error    down to Failed: it shakes and turns red
     reset    back to Idle; the next instance starts from the dot
   The heading names the event being handled (each keyframe's title);
   the line under the machine says the state the instance is in.
*/
text "on start: Idle" heading [font_size: 20, font_weight: 700, align: start]

circle start [size: 16, fill: role-ink, stroke: none]
row states [gap: 150, align: center] {
    rect idle    [label: "Idle",    width: 110, height: 46, corner_radius: 20]
    rect playing [label: "Playing", width: 110, height: 46, corner_radius: 20, fill: role-ok-soft]
    rect paused  [label: "Paused",  width: 110, height: 46, corner_radius: 20, fill: role-warn-soft]
}
rect failed [label: "Failed", width: 110, height: 46, corner_radius: 20, fill: role-error-soft, stroke: role-error]
constrain start.right = idle.left - 50
constrain start.center_y = idle.center_y
constrain failed.center_x = playing.center_x
constrain failed.top = states.bottom + 90

start -> idle as enter

// The transition table. The arrows are named by their row: arc_1 = play, arc_2 = pause,
// arc_3 = resume, arc_4 = stop, arc_5 = error, arc_6 = reset, arc_7 = seek.
let tr = [
    {from: idle,    to: playing, on: "play"},
    {from: playing, to: paused,  on: "pause"},
    {from: paused,  to: playing, on: "resume"},
    {from: playing, to: idle,    on: "stop"},
    {from: playing, to: failed,  on: "error"},
    {from: failed.left, to: idle.bottom, on: "reset"},   // a field may name a side
    {from: playing, to: playing, on: "seek"},            // a self-transition
]

// Between two states: one arrow.
each t in tr where t.from != t.to {
    t.from -> t.to as arc [label: t.on]
}

// To the same state: a curved loop over its top, through two points above it.
each t in tr where t.from == t.to {
    point up_l
    point up_r
    constrain up_l.center_x = t.from.center_x - 22
    constrain up_r.center_x = t.from.center_x + 22
    constrain up_l.center_y = t.from.top - 34
    constrain up_r.center_y = up_l.center_y
    t.from.top -> t.to.top as arc [via: [up_l, up_r], routing: curved, label: t.on]
}

// The legend reads the same list: one row per event.
col legend [gap: 4, align: start] {
    text "Events" legend_title [font_size: 14, font_weight: 700, align: start]
    each t, i in tr { text "{i+1}. {t.on}" ev [font_size: 13, align: start] }
}
constrain legend.left = paused.left
constrain legend.top = states.bottom + 60

text "state: Idle" status [font_size: 18, align: start]
constrain heading.left = start.left
constrain heading.bottom = states.top - 50
constrain status.left = heading.left
constrain status.top = failed.bottom + 30

// The instance: a token that waits on the start dot, then rides the arrows.
circle token [size: 18, fill: role-primary, stroke: role-surface, stroke_width: 3, appears: later,
              overlaps: [start, states, idle, playing, paused, failed]]
constrain token.center = start.center

motion [title: heading, title_swap: roll]

// Taking a transition: the event in the heading is highlighted, and so is the arrow the token rides.
motion take(arrow: path) {
    accent heading
    highlight arrow [duration: slow]
    move token along arrow [duration: slow]
}

keyframe "start" [title: "on start: Idle"] {
    show token [enter: pop]
    when token shown { move token along enter }
    when token arrives { mark idle; pulse idle }
}

keyframe "play" [title: "on play: Idle → Playing"] {
    take(arc_1)
    when token arrives {
        unmark idle
        mark playing [tone: ok]
        pulse playing
        transform status [label: "state: Playing", swap: roll]
    }
}

keyframe "pause" [title: "on pause: Playing → Paused"] {
    take(arc_2)
    when token arrives {
        unmark playing
        mark paused
        transform status [label: "state: Paused (waiting)", swap: roll]
        loop token [pulse, period: 1.2]       // waiting for the next event
    }
}

keyframe "resume" [title: "on resume: Paused → Playing"] {
    take(arc_3)
    when token arrives {
        unmark paused
        mark playing [tone: ok]
        pulse playing
        transform status [label: "state: Playing", swap: roll]
    }
}

keyframe "seek" [title: "on seek: Playing → Playing"] {
    take(arc_7)
    when token arrives { pulse playing }
}

keyframe "error" [title: "on error: Playing → Failed"] {
    take(arc_5)
    when token arrives {
        unmark playing
        shake failed
        mark failed [tone: error]
        transform token [fill: role-error]
        transform status [label: "state: Failed", swap: roll]
    }
}

keyframe "reset" [title: "on reset: Failed → Idle"] {
    take(arc_6)
    when token arrives {
        unmark failed
        mark idle
        pulse idle
        transform token [fill: initial]
        transform status [label: "state: Idle", swap: roll]
    }
}
