/* INTENT
   Communicate the fullstack-sota system architecture.
   Audience: developers joining the project.
   They should understand: what services exist, how they connect,
   and the major technology choices (Angular, Django, PostgreSQL, Redis, etc.)

   STRUCTURE
   Four bands from top to bottom: client + gateway, application, async, data.
   External services (auth, error tracking) sit in a column on the right.
   Django is drawn wide: it is the hub, and each box below it sits under its
   own part of Django, so every Django line drops straight down.
*/

// === KINDS OF BOX ===
template "svc" (name: "Service", w: 140) {
    rect body [width: w, height: 50, fill: accent-light, stroke: accent-dark, stroke_width: 2, label: name]
}
template "store" (name: "DB") {
    ellipse body [width: 140, height: 55, fill: secondary-light, stroke: secondary-dark, stroke_width: 2, label: name]
}
template "ext" (name: "External") {
    rect body [width: 140, height: 44, fill: foreground-3, stroke: foreground-1, stroke_width: 1, label: name]
}
template "zone" (name: "", tint: accent-light, edge: accent-dark) {
    rect body [fill: tint, stroke: edge, stroke_width: 1, opacity: 0.15,
               label: name, label_position: above, align: start, label_fill: edge, font_size: 12]
}

// === ZONES (declared first, so they are drawn behind) ===
zone app_bg   [name: "Application Layer"]
zone async_bg [name: "Async / Real-time"]
zone data_bg  [name: "Data Layer", tint: secondary-light, edge: secondary-dark]

// === BOXES ===
text "fullstack-sota Architecture" diagram_title [font_size: 18, fill: foreground-1]
ext browser [name: "Browser"]
svc nginx [name: "Nginx Gateway"]

svc angular [name: "Angular 21"]
svc django [name: "Django 6 API", w: 480]

svc channels [name: "Django Channels"]
svc celery [name: "Celery Workers"]

store redis [name: "Redis"]
store postgres [name: "PostgreSQL<br><small>+ PostGIS</small>"]
store minio [name: "MinIO / S3"]

ext keycloak [name: "OAuth2 / OIDC"]
ext sentry [name: "Sentry"]

// === LAYOUT ===
// Spine: title, browser, gateway and Django share one centre line.
constrain browser.center_x = diagram_title.center_x
constrain nginx.center_x = diagram_title.center_x
constrain django.center_x = diagram_title.center_x
constrain browser.top = diagram_title.bottom + 20
constrain nginx.top = browser.bottom + 50
constrain django.top = nginx.bottom + 80

// Application band: Angular to the left of Django.
constrain angular.center_y = django.center_y
constrain angular.right = django.left - 100

// Async band: Channels and Celery each under their own part of Django.
constrain channels.left = django.left - 60
constrain celery.left = channels.right + 60
constrain channels.top = django.bottom + 90
constrain celery.top = channels.top

// Data band: Redis under the gap between the two workers;
// PostgreSQL under both Celery and Django, MinIO under Django's right end.
constrain redis.center_x = midpoint(channels, celery)
constrain postgres.left = celery.right - 30
constrain minio.left = postgres.right + 20
constrain redis.top = channels.bottom + 90
constrain postgres.top = redis.top
constrain minio.top = redis.top

// External column on the right, level with what talks to it.
constrain keycloak.left = django.right + 80
constrain sentry.left = keycloak.left
constrain keycloak.center_y = nginx.center_y
constrain sentry.center_y = django.center_y

// Zones wrap their boxes.
constrain app_bg contains angular, django [padding: 20]
constrain async_bg contains channels, celery [padding: 20]
constrain data_bg contains redis, postgres, minio [padding_x: 60, padding_y: 20]   // title clears the Redis lines

// === CONNECTIONS ===
// One row per connection. Ends without a side let the router draw a straight
// line wherever two boxes overlap; a side (`nginx.left`) forces a corner.
each c in [
    {from: browser,        to: nginx,         on: "HTTP / WS"},
    {from: nginx,          to: keycloak,      on: "OIDC"},
    {from: nginx.left,     to: angular.top,   on: "/web/"},
    {from: nginx,          to: django,        on: "/fs/"},
    {from: angular,        to: django,        on: "REST API"},
    {from: django,         to: sentry,        on: "errors"},
    {from: django,         to: channels,      on: "WS"},
    {from: django,         to: celery,        on: "tasks"},
    {from: django,         to: postgres,      on: "ORM"},
    {from: django,         to: minio,         on: "files"},
    {from: channels,       to: redis,         on: "channel layer"},
    {from: celery,         to: redis,         on: "broker"},
    {from: celery,         to: postgres,      on: ""},
] {
    c.from -> c.to [label: c.on]
}
