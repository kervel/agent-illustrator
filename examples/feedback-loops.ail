// Human-agent feedback loops.
// Two loops of four steps: the human loop (slow, persistent) on top, the agent
// loop (fast, ephemeral) below. Each loop runs left to right and returns along a
// dashed line: over the top for the human, under the bottom for the agent.
// Thin lines between the rows are where the loops hand work to each other.

template "step" (name: "", tint: accent-light, ink: accent-dark) {
    rect body [width: 120, height: 50, fill: tint, stroke: ink, stroke_width: 2, label: name]
}

// The forward arrows of one loop: a -> b -> c -> d.
template "chain" (a: "", b: "", c: "", d: "", ink: accent-dark) {
    a -> b [stroke: ink, stroke_width: 3]
    b -> c [stroke: ink, stroke_width: 3]
    c -> d [stroke: ink, stroke_width: 3]
}

col diagram [gap: 90] {
    row human [gap: 40, align: center] {
        col human_head [gap: 4, align: end] {
            text "HUMAN" human_title [font_size: 14, fill: accent-dark]
            text "slow · persistent" human_sub [font_size: 11, fill: text-3]
        }
        row human_steps [gap: 30] {
            step assign   [name: "Assign Task"]
            step tune     [name: "Tune Feedback"]
            step spot     [name: "Spot Patterns"]
            step evaluate [name: "Evaluate"]
        }
    }
    row agent [gap: 40, align: center] {
        col agent_head [gap: 4, align: end] {
            text "AGENT" agent_title [font_size: 14, fill: secondary-dark]
            text "fast · ephemeral" agent_sub [font_size: 11, fill: text-3]
        }
        row agent_steps [gap: 30] {
            step task    [name: "Task",     tint: secondary-light, ink: secondary-dark]
            step execute [name: "Execute",  tint: secondary-light, ink: secondary-dark]
            step check   [name: "Feedback", tint: secondary-light, ink: secondary-dark]
            step result  [name: "Result",   tint: secondary-light, ink: secondary-dark]
        }
    }
}
// The two loops share columns, so the hand-over lines drop straight down.
constrain human_head.right = agent_head.right
constrain assign.left = task.left

// Each loop runs forward along its row and returns dashed around the outside:
// over the top for the human, under the bottom for the agent.
chain human_flow [a: assign, b: tune, c: spot, d: evaluate]
evaluate.top -> assign.top [stroke: accent-dark, stroke_width: 3, stroke_dasharray: dashed]
chain agent_flow [a: task, b: execute, c: check, d: result, ink: secondary-dark]
result.bottom -> task.bottom [stroke: secondary-dark, stroke_width: 3, stroke_dasharray: dashed]

// Hand-over between the loops
assign -> task [stroke: foreground-3, stroke_width: 1]
result -> evaluate [stroke: foreground-3, stroke_width: 1]
tune.bottom -> check.top [stroke: accent-1, stroke_width: 2, label: "tunes"]
