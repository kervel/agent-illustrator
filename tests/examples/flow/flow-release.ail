/* From idea to production, slide 6: a merge isn't a release.
   Render: agent-illustrator --stylesheet-css ../../../tools/slides/kapernikov-ail.css --animate flow-release.ail

   STORYBOARD
     merges   three merge requests join main, each fine on its own
     release  a release (v1.4) is tagged on main; GitLab builds it
     test     it goes to the test environment; people test the whole and find
              something: fine alone, slow together
     fix      a fix merge request joins main; release v1.4.1 is tagged
     retest   v1.4.1 replaces v1.4 on the test environment, and passes
     prod     on to production (sometimes via user acceptance first); the feature arrives
*/

import "flow-deck.ail"

template "person" from "assets/person.svg"

// A station on main: a ring on the line, its name below.
template "stop" (name: "Station", tint: role-primary) {
    circle dot [size: 40, fill: role-surface, stroke: tint, stroke_width: 8, appears: later]
    rect nm [caption_of: dot, label_position: below, label_offset: 10, label: name, font_size: 21,
             font_weight: 700, label_fill: role-ink, fill: none, stroke: none, max_width: 170, appears: later]
}

// An environment: a place where a release runs.
template "env" (name: "Environment", tint: role-primary, dash: "none") {
    rect box [width: 220, height: 100, fill: role-surface, stroke: tint, stroke_width: 4, stroke_dasharray: dash,
              corner_radius: 14]
    rect nm [caption_of: box, label_position: below, label_offset: 10, label: name, font_size: 21,
             font_weight: 700, label_fill: role-ink, fill: none, stroke: none]
}

// A release: what travels to the environments.
template "release" (nr: "v1") {
    rect bg [label: nr, font_family: mono, font_size: 21, font_weight: 700, label_fill: role-surface,
             fill: role-ink, stroke: none, corner_radius: 8, width: 120, height: 46]
}

// ---------------------------------------------------------------- stage

slide s [num: "6", title: "A merge isn't a release"]

// main, and the branches of the merge requests, drawn under their stations.
path br1 [through: [p1, m1.dot], routing: metro, drawn: 0, stroke: role-series-2, stroke_width: 10, fill: none]
path br2 [through: [p2, m2.dot], routing: metro, drawn: 0, stroke: role-series-2, stroke_width: 10, fill: none]
path br3 [through: [p3, m3.dot], routing: metro, drawn: 0, stroke: role-series-2, stroke_width: 10, fill: none]
path br4 [through: [p4, m4.dot], routing: metro, drawn: 0, stroke: role-series-2, stroke_width: 10, fill: none]
path track [through: [m1.dot, m2.dot, m3.dot, v14.dot, m4.dot, v141.dot], drawn: 0, extend_start: 60,
            extend_end: 60, stroke: role-primary, stroke_width: 14, fill: none]
rect main_lbl [label: "main", font_family: mono, font_size: 20, font_weight: 700, label_fill: role-primary,
               fill: none, stroke: none]
constrain main_lbl.right = m1.dot.left - 70
constrain main_lbl.center_y = m1.dot.center_y

stop m1 [name: "!58"]
stop m2 [name: "!59"]
stop m3 [name: "!60"]
stop v14 [name: "v1.4", tint: role-ink]
stop m4 [name: "!61"]
stop v141 [name: "v1.4.1", tint: role-ink]
constrain m1.dot.center_x = s.stage.left + 190
constrain m1.dot.center_y = s.stage.top + 220
constrain m2.dot.center_x = m1.dot.center_x + 120
constrain m3.dot.center_x = m2.dot.center_x + 120
constrain v14.dot.center_x = m3.dot.center_x + 150
constrain m4.dot.center_x = v14.dot.center_x + 260
constrain v141.dot.center_x = m4.dot.center_x + 150
constrain m2.dot.center_y = m1.dot.center_y
constrain m3.dot.center_y = m1.dot.center_y
constrain v14.dot.center_y = m1.dot.center_y
constrain m4.dot.center_y = m1.dot.center_y
constrain v141.dot.center_y = m1.dot.center_y

// Where the branches come from.
point p1
point p2
point p3
point p4
constrain p1.center_x = m1.dot.center_x - 60
constrain p1.center_y = m1.dot.center_y - 130
constrain p2.center_x = m2.dot.center_x - 60
constrain p2.center_y = p1.center_y
constrain p3.center_x = m3.dot.center_x - 60
constrain p3.center_y = p1.center_y
constrain p4.center_x = m4.dot.center_x - 60
constrain p4.center_y = p1.center_y

// The environments.
env test [name: "test environment", appears: later]
env uat [name: "user acceptance", dash: "12,9", appears: later]
env prod [name: "production", tint: role-ok, appears: later]
constrain test.box.center_x = v14.dot.center_x
constrain test.box.top = m1.dot.bottom + 170
constrain prod.box.center_x = s.stage.right - 150
constrain uat.box.center_x = midpoint(test.box, prod.box)
constrain uat.box.center_y = test.box.center_y
constrain prod.box.center_y = test.box.center_y

// The releases, and where they stand.
release r14 [nr: "v1.4", appears: later, overlaps: [test, uat, prod]]
release r141 [nr: "v1.4.1", appears: later, overlaps: [test, uat, prod]]
constrain r14.bg.center_x = v14.dot.center_x
constrain r14.bg.bottom = v14.dot.top - 16
constrain r141.bg.center_x = v141.dot.center_x
constrain r141.bg.bottom = v141.dot.top - 16
point at_test
point at_uat
point at_prod
constrain at_test.center_x = test.box.center_x
constrain at_test.center_y = test.box.center_y
constrain at_uat.center_x = uat.box.center_x
constrain at_uat.center_y = uat.box.center_y
constrain at_prod.center_x = prod.box.center_x
constrain at_prod.center_y = prod.box.center_y

// People testing the whole, and what they find.
row testers [gap: 12, align: bottom] {
    person t1 [width: 40, height: 47, tint: role-ink, appears: later]
    person t2 [width: 40, height: 47, tint: role-ink, appears: later]
    person t3 [width: 40, height: 47, tint: role-ink, appears: later]
}
constrain testers.right = test.box.left - 24
constrain testers.center_y = test.box.center_y
rect found [label: "fine alone · slow together", font_size: 20, font_weight: 700, label_fill: role-ink,
            fill: role-warn-soft, stroke: none, corner_radius: 8, appears: later]
constrain found.center_x = test.box.center_x
constrain found.top = test.box.bottom + 56

// The feature, arriving.
rect card [label: "Delivery date on the order", font_size: 19, font_weight: 700, label_fill: role-ink,
           fill: role-series-2-soft, stroke: role-ink, stroke_width: 2, corner_radius: 10, max_width: 190,
           appears: later]
constrain card.center_x = prod.box.center_x
constrain card.bottom = prod.box.top - 24

// ---------------------------------------------------------------- motion

keyframe "merges" [title: "A merge isn't a release"] {
    slide_in(s)
    at 0.2 { draw br1, br2, br3 [stagger: 0.15] }
    then { draw track [to: m3.dot] }
    when track reaches m1.dot { show m1.dot, m1.nm [enter: pop] }
    when track reaches m2.dot { show m2.dot, m2.nm [enter: pop] }
    when track reaches m3.dot { show m3.dot, m3.nm [enter: pop] }
}

keyframe "release" {
    draw track [to: v14.dot]
    when track reaches v14.dot { show v14.dot, v14.nm [enter: pop] }
    when v14.dot shown { show r14 [from: v14.dot] }
    when r14 shown { show test, uat, prod [enter: fade, stagger: 0.1] }
}

keyframe "test" {
    move r14 to at_test [duration: slow]
    when r14 arrives { show t1, t2, t3 [enter: pop, stagger: 0.1] }
}

keyframe "found" [auto] {
    show found [enter: rise]
    accent test.box [tone: error]
}

keyframe "fix" {
    draw br4
    then { draw track }
    when track reaches m4.dot { show m4.dot, m4.nm [enter: pop] }
    when track reaches v141.dot { show v141.dot, v141.nm [enter: pop] }
    when v141.dot shown { show r141 [from: v141.dot] }
}

keyframe "retest" {
    hide r14, found [exit: fade]
    move r141 to at_test [duration: slow]
    when r141 arrives { accent test.box [tone: ok] }
}

keyframe "prod" {
    move r141 to at_uat
    then { move r141 to at_prod }
    when r141 arrives { show card [enter: pop] }
}
