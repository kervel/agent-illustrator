// Shared parts of the single-page-app slides: `import "spa-parts.ail"`.
// Objects are artwork (assets/*.svg); windows and pages are diagram panels.
import "spa-deck.ail"

template "code_file" from "assets/code.svg"
template "phone_art" from "assets/phone.svg"
template "agent_art" from "assets/agent.svg"
template "person" from "assets/person.svg"

template "page" from "assets/docx.svg"
template "db" from "assets/db.svg"

// One row of the orders datagrid: three cells.
template "order_row" (nr: "", who: "", state: "", fill: role-surface, weight: 400) {
    row cells [gap: 0, padding: 0] {
        rect c_nr [width: 60, height: 42, fill: fill, stroke: role-rule, stroke_width: 1, corner_radius: 0, label: nr, font_family: mono,
                   font_size: 17, font_weight: weight, label_fill: role-ink]
        rect c_who [width: 210, height: 42, fill: fill, stroke: role-rule, stroke_width: 1, corner_radius: 0, label: who, align: start,
                    font_size: 18, font_weight: weight, label_fill: role-ink]
        rect c_state [width: 114, height: 42, fill: fill, stroke: role-rule, stroke_width: 1, corner_radius: 0, label: state, align: start,
                      font_size: 18, font_weight: weight, label_fill: role-ink]
    }
}

// A browser window: an address bar, and a page with header, menu and content.
template "browser" (url: "acme.example.com/orders", shows: "All orders") {
    rect bg [width: 620, height: 440, fill: role-surface, stroke: role-ink, stroke_width: 3, corner_radius: 14]
    rect bar [width: 620, height: 50, fill: role-surface-2, stroke: none, clip: bg,
              label: url, align: start, font_family: mono, font_size: 18, label_fill: role-muted]
    rect header [width: 580, height: 56, fill: role-primary, stroke: none, corner_radius: 6,
                 label: "Acme orders", align: start, font_size: 22, font_weight: 700, label_fill: role-surface]
    rect menu [width: 150, height: 272, fill: role-surface-2, stroke: none, corner_radius: 6,
               label: "Orders\nCustomers\nInvoices", font_size: 19, label_fill: role-ink]
    rect content [width: 414, height: 272, fill: role-surface, stroke: role-rule, stroke_width: 2, corner_radius: 6,
                  label: shows, font_size: 26, font_weight: 700, label_fill: role-ink]
    // The home page's call to action (hide it with `cta.appears: later` where the page starts elsewhere).
    rect cta [label: "Go to orders", font_size: 26, font_weight: 700, label_fill: role-surface,
              fill: role-primary, stroke: none, corner_radius: 12, width: 260, height: 70]
    // The orders list: a small datagrid (shown with `show web.table`).
    col table [gap: 0, padding: 0, appears: later] {
        order_row th [nr: "#", who: "customer", state: "status", fill: role-surface-2, weight: 700]
        order_row tr* [items: [
            {nr: "41", who: "Stroopwafels BV", state: "shipped"}, {nr: "42", who: "Acme Bikes", state: "open"},
            {nr: "43", who: "Delta Coffee", state: "open"}, {nr: "44", who: "Nordlicht AG", state: "shipped"}]]
    }
    constrain bar.top = bg.top
    constrain bar.left = bg.left
    constrain header.left = bg.left + 20
    constrain header.top = bar.bottom + 16
    constrain menu.left = header.left
    constrain menu.top = header.bottom + 16
    constrain content.right = header.right
    constrain content.top = menu.top
    constrain cta.center_x = content.center_x
    constrain cta.center_y = content.center_y
    constrain table.center_x = content.center_x
    constrain table.center_y = content.center_y
}

// A server window with a title bar.
template "server_win" (title: "Server") {
    rect bg [width: 400, height: 440, fill: role-surface, stroke: role-ink, stroke_width: 3, corner_radius: 14]
    rect bar [width: 400, height: 50, fill: role-surface-2, stroke: none, clip: bg,
              label: title, align: start, font_size: 21, font_weight: 700, label_fill: role-ink]
    constrain bar.top = bg.top
    constrain bar.left = bg.left
}
